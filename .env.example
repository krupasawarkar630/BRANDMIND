# ==============================================================================
# BRANDMIND — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local to configure your environment variables:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL / Neon Database)
# ------------------------------------------------------------------------------
# Required for real-time cloud persistence across all 12 stages.
# If omitted or offline, the app uses client-side reactive state.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ------------------------------------------------------------------------------
# 2. AI PROVIDER KEYS (Optional)
# ------------------------------------------------------------------------------
# By default, BRANDMIND runs its built-in deterministic heuristic AI engine.
# Set any of the keys below if you wish to connect live LLM providers:
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
